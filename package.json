{
  "name": "bit-twiddler",
  "version": "1.0.0",
  "description": "A swiss army developer toolkit",
  "main": "main.js",
  "scripts": {
    "build:html": "node build-html.js",
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./src/styles.css",
    "build:js": "esbuild src/renderer.js --bundle --outfile=src/bundle.js --format=esm --platform=browser",
    "build:all": "npm run build:html && npm run build:css && npm run build:js",
    "start": "npm run build:all && electron .",
    "pack": "npm run build:all && electron-builder --dir",
    "dist": "npm run build:all && electron-builder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arunkumar-mourougappane/bit-twiddler.git"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@tailwindcss/cli": "^4.2.2",
    "autoprefixer": "^10.4.19",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^4.2.2"
  },
  "dependencies": {
    "cronstrue": "^3.14.0",
    "jquery": "^4.0.0",
    "js-yaml": "^4.1.1",
    "marked": "^18.0.0",
    "qrcode": "^1.5.4",
    "sql-formatter": "^15.7.3"
  },
  "build": {
    "appId": "com.arunkumar.bittwiddler",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
